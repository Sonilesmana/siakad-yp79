// =====================================================================
// MainActivity.kt.snippet — tempel ke android/app/src/main/java/<paket>/MainActivity.kt
// Membutuhkan: Capacitor 6 (BridgeActivity), minSdk 23+.
// FLAG_SECURE = blokir screenshot & screen-record (layar hitam di hasil).
// =====================================================================
package id.ac.sekolah.ujiansecure

import android.app.ActivityManager
import android.content.Context
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.view.WindowManager
import android.widget.Toast
import com.getcapacitor.BridgeActivity

class MainActivity : BridgeActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // 1. BLOKIR SCREENSHOT & SCREEN RECORD — layar hitam di hasil rekaman
        window.setFlags(
            WindowManager.LayoutParams.FLAG_SECURE,
            WindowManager.LayoutParams.FLAG_SECURE
        )

        // 2. BLOKIR OVERLAY / TAPJACKING — tolak sentuhan dari window lain
        window.decorView.filterTouchesWhenObscured = true

        // 3. Deteksi Developer Options / USB debugging → peringatan keras
        if (isDevModeOn()) {
            Toast.makeText(
                this,
                "PERINGATAN: Developer Options / USB debugging aktif. Matikan untuk lanjut ujian.",
                Toast.LENGTH_LONG
            ).show()
            // Opsional tegas: finish() bila kebijakan mewajibkan
            // finish(); return
        }

        // 4. Screen pinning / LockTask bila device-owner / pinning disetujui
        //    (membutuhkan user consent kecuali Device Owner via MDM).
        try {
            val am = getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
            if (am.lockTaskModeState == ActivityManager.LOCK_TASK_MODE_NONE) {
                // startLockTask() meminta PIN confirmation di non-device-owner.
                // Panggil setelah user menekan "Mulai" bila ingin pinning penuh.
                // startLockTask()
            }
        } catch (_: Exception) { }
    }

    private fun isDevModeOn(): Boolean {
        val dev = Settings.Secure.getInt(
            contentResolver, Settings.Global.DEVELOPMENT_SETTINGS_ENABLED, 0
        ) == 1
        val adb = Settings.Secure.getInt(
            contentResolver, Settings.Global.ADB_ENABLED, 0
        ) == 1
        return dev || adb
    }

    // 5. BLOKIR SPLIT-SCREEN / PICTURE-IN-PICTURE — tolak masuk mode tersebut
    override fun onMultiWindowModeChanged(isInMultiWindowMode: Boolean) {
        super.onMultiWindowModeChanged(isInMultiWindowMode)
        if (isInMultiWindowMode) {
            Toast.makeText(this, "Split-screen dilarang selama ujian.", Toast.LENGTH_SHORT).show()
            // Paksa kembali ke fullscreen (API 24+): minimize lalu resume
            moveTaskToBack(false)
        }
    }

    override fun onPictureInPictureModeChanged(isInPip: Boolean) {
        super.onPictureInPictureModeChanged(isInPip)
        if (isPip) moveTaskToBack(false)
    }

    // 6. Jangan izinkan masuk recent-after-finish (didukung manifest noHistory),
    //    dan hentikan lock-task saat keluar.
    override fun onDestroy() {
        try { stopLockTask() } catch (_: Exception) { }
        super.onDestroy()
    }
}
